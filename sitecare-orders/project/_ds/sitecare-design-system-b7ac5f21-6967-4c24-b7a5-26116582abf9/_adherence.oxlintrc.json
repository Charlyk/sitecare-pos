{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Outfit|Inter|Caveat))/i]",
        "message": "Font not provided by the design system. Available: Outfit, Inter, Caveat."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--sc-accent",
      "--sc-accent-foreground",
      "--sc-background",
      "--sc-black",
      "--sc-border",
      "--sc-card",
      "--sc-card-foreground",
      "--sc-container",
      "--sc-destructive",
      "--sc-duration",
      "--sc-easing",
      "--sc-font-handwriting",
      "--sc-font-sans",
      "--sc-foreground",
      "--sc-input",
      "--sc-muted",
      "--sc-muted-foreground",
      "--sc-navbar-height",
      "--sc-primary",
      "--sc-primary-foreground",
      "--sc-primary-hover",
      "--sc-primary-soft",
      "--sc-radius-2xl",
      "--sc-radius-3xl",
      "--sc-radius-hero",
      "--sc-radius-lg",
      "--sc-radius-md",
      "--sc-radius-pill",
      "--sc-radius-sm",
      "--sc-radius-xl",
      "--sc-ring",
      "--sc-secondary",
      "--sc-secondary-foreground",
      "--sc-shadow-2xl",
      "--sc-shadow-lg",
      "--sc-shadow-md",
      "--sc-shadow-sm",
      "--sc-shadow-xl",
      "--sc-slate-100",
      "--sc-slate-200",
      "--sc-slate-50",
      "--sc-slate-700",
      "--sc-terracotta",
      "--sc-terracotta-hover",
      "--sc-tracking-tight",
      "--sc-type-body",
      "--sc-type-display",
      "--sc-type-eyebrow",
      "--sc-type-h1",
